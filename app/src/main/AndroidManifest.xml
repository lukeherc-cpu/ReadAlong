<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <!-- "Import from Audible" checks whether LibriSync is installed so it can offer to open it. -->
    <queries>
        <package android:name="tech.henning.librisync" />
    </queries>
    <application
        android:name=".ReadAlongApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:largeHeap="true"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ReadAlong">
        <receiver android:name=".data.transcription.DismissTranscriptionReceiver" android:exported="false" />
        <receiver android:name=".data.transcription.ResumeTranscriptionReceiver" android:exported="false" />
        <receiver android:name=".data.transcription.PauseTranscriptionReceiver" android:exported="false" />
        <service android:name=".data.processing.AudiobookTranscriptionService" android:foregroundServiceType="dataSync|mediaProcessing" android:exported="false" />
        <service android:name=".data.transcription.ModelValidationService" android:process=":model_validation" android:exported="false" />
        <service android:name=".data.transcription.SecondRecognitionService" android:process=":recognition_2" android:exported="false" />
        <service android:name=".data.transcription.ThirdRecognitionService" android:process=":recognition_3" android:exported="false" />
        <service android:name=".data.transcription.RecognitionService" android:process=":recognition" android:exported="false" />
        <service android:name="androidx.work.impl.foreground.SystemForegroundService" android:foregroundServiceType="dataSync|mediaProcessing" tools:node="merge" />
        <service android:name=".playback.AudiobookService" android:foregroundServiceType="mediaPlayback" android:exported="true">
            <intent-filter><action android:name="androidx.media3.session.MediaSessionService" /></intent-filter>
        </service>
        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.files" android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ReadAlong"
            android:windowSoftInputMode="adjustResize">

        </activity>
        <activity android:name=".ui.launch.BlueLightLauncher" android:exported="true" android:enabled="true" android:icon="@mipmap/launcher_blue_light" android:theme="@style/Launch_Blue_Light" android:label="@string/app_name" android:windowSoftInputMode="adjustResize"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity>
