<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="12dp"
    android:clipToOutline="true" android:background="@drawable/widget_shape" android:backgroundTint="#FFF3ECE4">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#FF7B6F66" android:textSize="11sp" android:textStyle="bold" android:textAllCaps="true" android:maxLines="1" android:ellipsize="end" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_readalong_label" android:textColor="#FF7B6F66" android:textSize="11sp" />
    </LinearLayout>
    <TextView android:id="@+id/widget_sentence" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp"
        android:fontFamily="@font/literata" android:textColor="#FF2A2622" android:textSize="16sp" android:lineSpacingExtra="3sp" android:ellipsize="end" />
</LinearLayout>
