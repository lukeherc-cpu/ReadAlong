<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="8dp" android:gravity="center_vertical"
    android:clipToOutline="true" android:background="@drawable/widget_shape" android:backgroundTint="#FF3D2E1F">
    <ImageView android:id="@+id/widget_cover" android:layout_width="48dp" android:layout_height="48dp" android:scaleType="centerCrop" android:contentDescription="@string/widget_open_player" android:src="@drawable/widget_preview_cover" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.7" android:layout_marginStart="12dp" android:layout_marginEnd="4dp" android:orientation="vertical">
        <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:text="@string/widget_preview_title" />
        <TextView android:id="@+id/widget_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#CCFFFFFF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:text="@string/widget_preview_chapter" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.3" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/widget_back" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:padding="8dp" android:src="@drawable/ic_rewind" android:contentDescription="@string/widget_back" />
        <FrameLayout android:layout_width="48dp" android:layout_height="48dp">
            <ImageView android:id="@+id/widget_play_bg" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/widget_circle" android:importantForAccessibility="no" android:tint="#FFF1E4CC" />
            <ImageView android:id="@+id/widget_play" android:layout_width="48dp" android:layout_height="48dp" android:padding="13dp" android:src="@drawable/ic_play" android:contentDescription="@string/widget_play" android:tint="#FF3A2A1C" />
        </FrameLayout>
        <ImageView android:id="@+id/widget_forward" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:padding="8dp" android:src="@drawable/ic_forward" android:contentDescription="@string/widget_forward" />
    </LinearLayout>
</LinearLayout>
