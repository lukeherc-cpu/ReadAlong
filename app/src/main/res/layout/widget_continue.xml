<?xml version="1.0" encoding="utf-8"?>
<!-- Bookshelf: covers fill each shelf edge to edge, and the shelves sit right under them. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="10dp" android:paddingBottom="12dp"
    android:clipToOutline="true" android:background="@drawable/widget_shape" android:backgroundTint="#FF2B2119">
    <TextView android:id="@+id/widget_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="2dp" android:paddingBottom="6dp"
        android:text="@string/widget_continue_title" android:textColor="#FFF1E4CC" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" />
    <LinearLayout android:id="@+id/widget_row_0" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:paddingStart="4dp" android:paddingEnd="4dp">
            <ImageView android:id="@+id/widget_book_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="8dp"
                android:scaleType="centerCrop" android:background="@drawable/widget_book_shape" android:clipToOutline="true" />
            <ImageView android:id="@+id/widget_book_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="8dp"
                android:scaleType="centerCrop" android:background="@drawable/widget_book_shape" android:clipToOutline="true" />
            <ImageView android:id="@+id/widget_book_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:scaleType="centerCrop" android:background="@drawable/widget_book_shape" android:clipToOutline="true" />
    </LinearLayout>
    <ImageView android:id="@+id/widget_shelf_0" android:layout_width="match_parent" android:layout_height="7dp" android:layout_marginBottom="8dp" android:src="@drawable/widget_shelf" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:id="@+id/widget_row_1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:paddingStart="4dp" android:paddingEnd="4dp">
            <ImageView android:id="@+id/widget_book_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="8dp"
                android:scaleType="centerCrop" android:background="@drawable/widget_book_shape" android:clipToOutline="true" />
            <ImageView android:id="@+id/widget_book_4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="8dp"
                android:scaleType="centerCrop" android:background="@drawable/widget_book_shape" android:clipToOutline="true" />
            <ImageView android:id="@+id/widget_book_5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:scaleType="centerCrop" android:background="@drawable/widget_book_shape" android:clipToOutline="true" />
    </LinearLayout>
    <ImageView android:id="@+id/widget_shelf_1" android:layout_width="match_parent" android:layout_height="7dp" android:layout_marginBottom="0dp" android:src="@drawable/widget_shelf" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <TextView android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:paddingStart="2dp" android:paddingTop="6dp"
        android:text="@string/widget_nothing_started" android:textColor="#B3F1E4CC" android:textSize="12sp" />
</LinearLayout>
