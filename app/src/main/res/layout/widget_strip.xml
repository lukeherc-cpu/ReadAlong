<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp" android:gravity="center_vertical"
    android:clipToOutline="true" android:background="@drawable/widget_shape" android:backgroundTint="#FF20252B">
    <ImageView android:id="@+id/widget_cover" android:layout_width="44dp" android:layout_height="44dp" android:scaleType="centerCrop" android:contentDescription="@string/widget_open_player" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.6" android:layout_marginStart="10dp" android:orientation="vertical">
        <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#CCFFFFFF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.4" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/widget_back" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:padding="10dp" android:src="@drawable/ic_rewind" android:contentDescription="@string/widget_back" />
        <FrameLayout android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1">
            <ImageView android:id="@+id/widget_play_bg" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center" android:src="@drawable/widget_circle" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/widget_play" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center" android:padding="13dp" android:src="@drawable/ic_play" android:contentDescription="@string/widget_play" />
        </FrameLayout>
        <ImageView android:id="@+id/widget_forward" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:padding="10dp" android:src="@drawable/ic_forward" android:contentDescription="@string/widget_forward" />
    </LinearLayout>
</LinearLayout>
